# Server-only Resend API key. Never prefix this with VITE_.
RESEND_API_KEY=re_xxxxxxxxx

# Verified Resend sender. Must be from a domain configured in Resend.
RESEND_FROM=BetaManuscript <hello@your-domain.com>

# Optional reply-to address for the confirmation email.
RESEND_REPLY_TO=

# Inbox that receives product feature requests. Falls back to RESEND_REPLY_TO
# when this is not set.
FEATURE_REQUESTS_TO=

# Add new contacts to the BetaManuscript waitlist segment.
RESEND_WAITLIST_SEGMENT_ID=seg_xxxxxxxxx

# Public Supabase credentials. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional canonical app URL for transactional links. The current request host
# is used in local development when this is empty.
NEXT_PUBLIC_APP_URL=http://localhost:3434

# Cloudflare Turnstile sitekey used by the login and email sign-up forms. This
# value is public. The matching secret must stay server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Public analytics config.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional comma-separated public IPs whose browser sessions must not initialize
# PostHog. Configure the same value in the production environment.
POSTHOG_INTERNAL_IPS=

# Stripe. These credentials must only be used from server-side code.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx
STRIPE_BETAMANUSCRIPT_PRO_PRICE_ID=price_xxxxxxxxx
STRIPE_BETAMANUSCRIPT_PRO_YEARLY_PRICE_ID=price_xxxxxxxxx

# Server-only Supabase key used by the verified Stripe webhook. Never expose it
# through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only secret used by Vercel Cron to send grouped reader-place-request
# notifications. Set the same secret in the production Vercel environment.
CRON_SECRET=
